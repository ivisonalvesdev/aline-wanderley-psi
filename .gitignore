node_modules
dist
*.local
.DS_Store
.claude/settings.local.json

# PNGs originais das fotos, mantidos localmente como backup — o site usa
# as versões .webp em assets/. Peso alto (4,8 MB) sem necessidade no repo.
assets/originais-png/

# Originais dos vídeos de fundo. O site usa o resultado de `npm run video`
# — assets/formacao.mp4 e assets/orientacao-parental.mp4, ambos em 1080p.
# Ver scripts/build-videos.mjs.
assets/video-origem/
assets/video-orientacao-parental/

# Arquivos de fonte. A fonte de assinatura em uso é a versão DEMO da
# Halimun, licenciada só para uso pessoal — redistribuir o .ttf num
# repositório é, por si só, uma violação da licença, independente do
# site. Fica só na máquina de quem desenvolve até a licença comercial
# ser comprada (ou a fonte, trocada). Ver o comentário em
# src/styles/index.css.
assets/fontes/

# Export do protótipo das bolhas, vindo do Figma Make. Veio com a
# biblioteca shadcn/ui inteira (~270 KB) e com os nomes dos arquivos
# trocados — o efeito estava dentro de "alert-dialog.tsx". Já foi
# portado para src/components/BubbleField.tsx; a pasta fica só como
# referência local.
efeito-bolhas/
